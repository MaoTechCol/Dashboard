SESSION_COOKIE_SECURE=true
SESSION_TTL_MINUTES=720
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-me
SEED_CLIENT_PASSWORD=replace-me
ANOMALY_FUTURE_TOLERANCE_MINUTES=5
LIVE_RETENTION_DAYS=40
ANOMALY_RETENTION_DAYS=90
HOWEN_REQUEST_SPACING_SECONDS=2.5
CATCHUP_OVERLAP_MINUTES=10
CATCHUP_BOOTSTRAP_HOURS=6
CATCHUP_STALE_AFTER_MINUTES=90
CATCHUP_MAX_WINDOW_MINUTES=20
CATCHUP_DEVICE_BATCH_SIZE=1
CATCHUP_CHECK_INTERVAL_MINUTES=5
CATCHUP_RUN_TIME_BUDGET_SECONDS=20
CATCHUP_BATCH_PAUSE_SECONDS=2.0
CATCHUP_RATE_LIMIT_BASE_SECONDS=300
CATCHUP_RATE_LIMIT_MAX_SECONDS=3600
CATCHUP_ERROR_RETRY_SECONDS=300
